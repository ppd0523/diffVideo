<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiffVideo.Core\DiffVideo.Core.csproj" />
    <ProjectReference Include="..\DiffVideo.Infrastructure\DiffVideo.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DiffVideo</AssemblyName>
    <RootNamespace>DiffVideo.App</RootNamespace>
    <Version>0.4.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DiffVideo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DiffVideo.ico" />
    <Resource Include="Assets\Fonts\D2Coding.ttf" />
    <Resource Include="Assets\Fonts\D2CodingBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\ffmpeg\bin\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\tools\ffmpeg\bin\ffprobe.exe" Link="ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\tools\ffmpeg\licenses\FFmpeg-LICENSE.txt" Link="licenses\FFmpeg-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\NAudio-LICENSE.txt" Link="licenses\NAudio-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\MaterialIcons-LICENSE.txt" Link="licenses\MaterialIcons-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\D2Coding-LICENSE.txt" Link="licenses\D2Coding-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\IMPLEMENTATION-PLAN.md" Link="docs\IMPLEMENTATION-PLAN.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\PREVIEW-ARCHITECTURE.md" Link="docs\PREVIEW-ARCHITECTURE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\RESOURCE-COMPARISON.md" Link="docs\RESOURCE-COMPARISON.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\VALIDATION-0.3.0.md" Link="docs\VALIDATION-0.3.0.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\UI-DESIGN.md" Link="docs\UI-DESIGN.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="3.0.1" />
  </ItemGroup>

</Project>
