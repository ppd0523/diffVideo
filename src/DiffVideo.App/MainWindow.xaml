<Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="2" Background="#8150C8" HorizontalAlignment="Center"/><Border Width="6" Height="16" Background="#8150C8" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid></ControlTemplate></Thumb.Template></Thumb>
</Canvas>
<Canvas x:Name="ExportRangeHandleOverlay" ClipToBounds="True">
