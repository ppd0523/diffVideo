<TextBlock x:Name="Video1FileName" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/></DockPanel>
<DockPanel Grid.Row="2" DataContext="{Binding Video2}" Margin="0,0,6,0" IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
<CheckBox x:Name="Video2AudioCheckBox" DockPanel.Dock="Right" Style="{StaticResource TimelineAudioIconCheckBox}" IsChecked="{Binding IncludeAudio}" IsEnabled="{Binding HasAudio}"/>

<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Width="18" Height="18"/><TextBlock Text="2" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/></StackPanel>
<TextBlock x:Name="Video2FileName" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/></DockPanel>
<DockPanel Grid.Row="3" DataContext="{Binding Audio}" Margin="0,0,6,0" IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
<CheckBox x:Name="Mp3AudioCheckBox" DockPanel.Dock="Right" Style="{StaticResource TimelineAudioIconCheckBox}" IsChecked="{Binding IncludeAudio}" IsEnabled="{Binding HasMedia}"/>
<Slider DockPanel.Dock="Right" Width="42" Margin="2,0,4,0" Minimum="0" Maximum="200" Value="{Binding VolumePercent}" ToolTip="MP3 볼륨 0~200%" AutomationProperties.Name="MP3 볼륨"/>
<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"><ContentControl Content="{StaticResource Icon.MusicNote}" Style="{StaticResource MaterialIcon}" Width="18" Height="18"/><TextBlock Text="" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/></StackPanel>
<TextBlock x:Name="AudioFileName" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/></DockPanel>
                <DockPanel Grid.Row="4" DataContext="{Binding Audio}" IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,0">
                    <ContentControl Content="{StaticResource Icon.MusicNote}" Style="{StaticResource MaterialIcon}" ToolTip="MP3 시작 시각 (초 · 0.001 단위)" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBox x:Name="Mp3StartInput" Text="{Binding StartSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" ToolTip="MP3 시작 시각 (초 · 0.001 단위)" AutomationProperties.Name="MP3 시작 시각" IsEnabled="{Binding HasMedia}" />
                </DockPanel>

<Thumb x:Name="TimelineLabelSplitter" Grid.Column="1" Grid.RowSpan="6" Cursor="SizeWE" DragDelta="TimelineLabel_DragDelta" ToolTip="파일명 영역 너비 조절">
<Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="1" Background="{StaticResource HairlineBrush}" HorizontalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
<Grid x:Name="TimelineViewportHost" Grid.Column="2" Grid.RowSpan="5" ClipToBounds="True" SizeChanged="Timeline_SizeChanged">
