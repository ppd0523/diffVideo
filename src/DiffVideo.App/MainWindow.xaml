<Window x:Class="DiffVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DiffVideo.App.Converters"
        xmlns:controls="clr-namespace:DiffVideo.App.Controls"
        xmlns:vm="clr-namespace:DiffVideo.App.ViewModels"
        Title="DiffVideo" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        Style="{StaticResource {x:Type Window}}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated">
    <Window.Resources>
        <conv:TimelinePositionConverter x:Key="TimelinePosition" />
        <conv:TimelineWidthConverter x:Key="TimelineWidth" />
        <conv:ClipHeightConverter x:Key="ClipHeight" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="ExportBoundaryThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border Background="{StaticResource WarningBrush}" CornerRadius="0"><TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource CanvasBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MediaSelector" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{StaticResource MediumBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextBoxButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="3.6,2.4" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MediumBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter TargetName="Surface" Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlacementHandle" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#FAFAF9" />
            <Setter Property="BorderBrush" Value="#78716C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <Style x:Key="TrackOverlay" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CanvasBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LilacBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimelineClip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Visibility" Value="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <Style x:Key="VideoTimelineClip" TargetType="Border" BasedOn="{StaticResource TimelineClip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource CanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainRootGrid" Margin="8">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition x:Name="TimelineRow" Height="264" MinHeight="264"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PreviewWorkspace" Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="216" /></Grid.ColumnDefinitions>
                <Border x:Name="PreviewDropHost" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="0" Padding="12"
                        AllowDrop="True" Drop="Preview_Drop" DragOver="Preview_DragOver" DragLeave="Preview_DragLeave" SizeChanged="PreviewDropHost_SizeChanged"
                        ToolTip="정지·일시정지: 왼쪽 드래그로 이동 · 변/모서리로 크기 조절 · 오른쪽 드래그로 ROI 지정 · Esc 취소 · Space 재생/일시정지">
                    <Grid>
                        <Viewbox x:Name="PreviewViewbox" Stretch="Uniform">
                            <Grid x:Name="PreviewLogicalCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="Black" Focusable="True"
                                  PreviewMouseRightButtonDown="PreviewRoi_RightButtonDown" PreviewMouseRightButtonUp="PreviewRoi_RightButtonUp"
                                  PreviewMouseMove="PreviewRoi_MouseMove" LostMouseCapture="PreviewRoi_LostMouseCapture">
                                <Image Source="{Binding PreviewImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <ItemsControl x:Name="PreviewOverlays" ItemsSource="{Binding Videos}" ClipToBounds="True" IsHitTestVisible="{Binding IsEditingEnabled}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding DestinationX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding DestinationY}" />
                                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TrackOverlay}" Width="{Binding DestinationWidth}" Height="{Binding DestinationHeight}"
                                                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}"
                                                    MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                                                    LostMouseCapture="Overlay_LostMouseCapture">
                                                <Grid>
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                    <Border Style="{StaticResource PlacementHandle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                    <Border Background="#E61C1917" CornerRadius="0" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                                        <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Foreground="{StaticResource CanvasBrush}" Width="28" Height="28" /><TextBlock Text="{Binding Name}" Foreground="{StaticResource CanvasBrush}" FontSize="22" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                                    </Border>
                                                    <Border Background="#CC1C1917" CornerRadius="0" Padding="16,12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                            Visibility="{Binding IsLagging, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel>
                                                            <ProgressBar IsIndeterminate="True" Width="96" Height="4" />
                                                            <TextBlock Text="버퍼링" Foreground="{StaticResource CanvasBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Rectangle x:Name="PreviewRoiSelection" Visibility="Collapsed" Stroke="{StaticResource CanvasBrush}" Fill="#4078716C" StrokeDashArray="4,2" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <controls:CoordinateTip x:Name="PreviewCoordinateTip" Panel.ZIndex="120"/>
                        <Border Background="{StaticResource SurfaceBrush}">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasComposition}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Button Click="OpenFiles_Click" IsEnabled="{Binding IsEditingEnabled}"
                                    Width="240" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="영상 프리뷰 · MP4 영상 또는 MP3 음원을 끌어 놓거나 클릭하여 열기"
                                    AutomationProperties.Name="영상 또는 음원 열기"
                                    AutomationProperties.HelpText="영상 프리뷰 구역입니다. MP4 영상 또는 MP3 음원을 끌어 놓을 수 있습니다.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Rectangle Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeDashArray="4,4" Margin="1" />
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <ContentControl Content="{StaticResource Icon.VideoLibrary}" Style="{StaticResource MaterialIcon}" Foreground="{TemplateBinding Foreground}" Width="64" Height="64" />
                                                            <Path Data="M 12,0 L 12,20 M 4,12 L 12,20 L 20,12 M 0,24 L 0,28 L 24,28 L 24,24"
                                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Width="28" Height="32" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <Border x:Name="PreviewLoadingOverlay" Background="#CC1C1917" CornerRadius="0" IsHitTestVisible="False" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="100">
                            <Border Background="{StaticResource CanvasBrush}" CornerRadius="0" Padding="24,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Width="176">
                                    <TextBlock Text="재생 동기화 중…" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <ProgressBar IsIndeterminate="True" Height="4" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border x:Name="PreviewDropHint" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6FAFAF9" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="3" CornerRadius="0" Panel.ZIndex="110">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl Content="{StaticResource Icon.FolderOpen}" Style="{StaticResource MaterialIcon}" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="놓아서 MP4 / MP3 추가" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            <Border x:Name="InspectorPanel" Grid.Column="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="0" Padding="12">
                <Grid>
                    <TabControl x:Name="SettingsTabs" SelectedIndex="1">
                        <TabItem x:Name="CanvasSettingsTab" Header="캔버스">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsEnabled="{Binding IsEditingEnabled}">
                                    <TextBlock Text="캔버스 크기" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <TextBox Text="{Binding CanvasWidth, UpdateSourceTrigger=LostFocus}" ToolTip="캔버스 너비 (px)" AutomationProperties.Name="캔버스 너비" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding CanvasHeight, UpdateSourceTrigger=LostFocus}" ToolTip="캔버스 높이 (px)" AutomationProperties.Name="캔버스 높이" Margin="4,0,0,0" />
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <Button Content="720p" Click="Canvas720_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                                        <Button Content="1080p" Click="Canvas1080_Click" Style="{StaticResource CompactButton}" Margin="2,0" />
                                        <Button Content="4K" Click="Canvas4K_Click" Style="{StaticResource CompactButton}" Margin="4,0,0,0" />
                                    </UniformGrid>
                                    <Border Height="1" Background="{StaticResource SoftHairlineBrush}" Margin="0,24,0,0" />
                                    <TextBlock Text="프레임 레이트" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="fps" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBox x:Name="FpsInput" Text="{Binding OutputFps, UpdateSourceTrigger=LostFocus}" ToolTip="출력 프레임 레이트 (1~60 fps)" AutomationProperties.Name="출력 프레임 레이트" />
                                    </DockPanel>
                                    <UniformGrid Columns="5" Margin="0,8,0,0">
                                        <Button x:Name="Fps24Button" Content="24" Tag="24" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Margin="0,0,3,0" />
                                        <Button Content="25" Tag="25" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Margin="1.5,0" />
                                        <Button Content="30" Tag="30" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Margin="1.5,0" />
                                        <Button Content="50" Tag="50" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Margin="1.5,0" />
                                        <Button Content="60" Tag="60" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Margin="3,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock Text="품질" Style="{StaticResource FieldLabel}" />
                                    <UniformGrid Columns="3">
                                        <Button x:Name="QualityHighButton" Content="High" Tag="High" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                                        <Button Content="Mid" Tag="Balanced" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Margin="2,0" />
                                        <Button Content="Low" Tag="Small" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Margin="4,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="VideoSettingsTab" Header="영상">
                            <Grid IsEnabled="{Binding IsEditingEnabled}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto"/><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Style="{StaticResource MediaSelector}" Click="MediaVideo_Click" ToolTip="미디어 추가" AutomationProperties.Name="미디어 추가"><StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Add}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" /><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" Margin="4,0,0,0" /></StackPanel></Button>
                                    <Button x:Name="ResetRoiButton" Content="{StaticResource Icon.CropFree}" Style="{StaticResource MaterialIconButton}" Width="30" Height="30" MinHeight="30" ToolTip="선택 영상의 ROI를 원본 전체로 복원" Click="ResetRoi_Click" IsEnabled="{Binding SelectedVideo.HasMedia}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Button x:Name="SelectedVideoFileButton" Style="{StaticResource TextBoxButton}" Click="SelectedVideoFile_Click" ToolTip="영상 선택 또는 교체" AutomationProperties.Name="선택 영상 파일" Margin="0,0,0,12">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Right" Content="{StaticResource Icon.FolderOpen}" Style="{StaticResource MaterialIcon}" Width="18" Height="18" Margin="8,0,0,0" />
                                            <TextBlock x:Name="SelectedVideoFileName" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedVideo.DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="Text" Value="{Binding SelectedVideo.DisplayName}" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedVideo.HasMedia}" Value="False"><Setter Property="Text" Value="영상 선택…" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="레이어" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Button x:Name="SendBackwardButton" Content="{StaticResource Icon.FlipToBack}" Click="SendBackward_Click" Style="{StaticResource MaterialIconButton}" Width="30" Height="30" MinHeight="30" ToolTip="선택한 영상을 뒤로 보내기" Margin="0,0,8,0" />
                                        <Button x:Name="BringForwardButton" Content="{StaticResource Icon.FlipToFront}" Click="BringForward_Click" Style="{StaticResource MaterialIconButton}" Width="30" Height="30" MinHeight="30" ToolTip="선택한 영상을 앞으로 가져오기" />
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel DataContext="{Binding SelectedVideo}">
                                        <TextBlock Text="배치" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                                        <DockPanel><TextBlock Text="시작" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBox Padding="3.6,2.4" MinHeight="30" Text="{Binding StartSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" ToolTip="영상 시작 시각 (초)" AutomationProperties.Name="영상 시작 시각" /></DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><ContentControl Content="{StaticResource Icon.OpenWith}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" ToolTip="캔버스 위치" /><TextBlock Text="X / Y" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" /></StackPanel>
                                        <UniformGrid Columns="2"><TextBox Padding="3.6,2.4" MinHeight="30" Text="{Binding DestinationX}" Margin="0,0,4,0" ToolTip="X 위치" AutomationProperties.Name="X 위치" /><TextBox Padding="3.6,2.4" MinHeight="30" Text="{Binding DestinationY}" Margin="4,0,0,0" ToolTip="Y 위치" AutomationProperties.Name="Y 위치" /></UniformGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><ContentControl Content="{StaticResource Icon.AspectRatio}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" ToolTip="표시 크기" /><TextBlock Text="너비 / 높이" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" /></StackPanel>
                                        <UniformGrid Columns="2"><TextBox Padding="3.6,2.4" MinHeight="30" Text="{Binding DestinationWidth}" Margin="0,0,4,0" AutomationProperties.Name="표시 너비" /><TextBox Padding="3.6,2.4" MinHeight="30" Text="{Binding DestinationHeight}" Margin="4,0,0,0" AutomationProperties.Name="표시 높이" /></UniformGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <CheckBox x:Name="AspectLockCheckBox" Style="{StaticResource AspectLockIconCheckBox}" IsChecked="{Binding AspectRatioLocked}" Margin="0,0,8,0" />
                                            <Button x:Name="FitModeFitButton" Content="{StaticResource Icon.FitFrame}" Tag="Fit" Click="FitMode_Click" ToolTip="맞춤 · 영상을 프레임 안에 모두 표시" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FitModeIconButton}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions><Condition Binding="{Binding AspectRatioLocked}" Value="False" /><Condition Binding="{Binding FitMode}" Value="Fit" /></MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="FitModeFillButton" Content="{StaticResource Icon.FillFrame}" Tag="Fill" Click="FitMode_Click" ToolTip="채우기 · 프레임을 채우고 넘치는 가장자리를 자름" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FitModeIconButton}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions><Condition Binding="{Binding AspectRatioLocked}" Value="False" /><Condition Binding="{Binding FitMode}" Value="Fill" /></MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="FitModeStretchButton" Content="{StaticResource Icon.StretchFrame}" Tag="Stretch" Click="FitMode_Click" ToolTip="늘이기 · 영상 비율을 프레임 크기에 맞춤">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FitModeIconButton}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions><Condition Binding="{Binding AspectRatioLocked}" Value="False" /><Condition Binding="{Binding FitMode}" Value="Stretch" /></MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <Border Height="1" Background="{StaticResource SoftHairlineBrush}" Margin="0,24,0,0" />
                                        <TextBlock Text="자르기" Style="{StaticResource FieldLabel}" />
