    <Border x:Name="ExportBeforeShade" Background="#20000000"/>
    <Border x:Name="ExportAfterShade" Background="#20000000"/>
    <Border x:Name="ExportRangeBand" Height="22" Background="#30D49A22"/>
    <Border x:Name="ExportStartLine" Width="2" Background="#9B6500"/>
    <Border x:Name="ExportEndLine" Width="2" Background="#9B6500"/>
</Canvas>
<Canvas x:Name="TimelineMarkerOverlay" ClipToBounds="True" IsHitTestVisible="False">
<ContentControl x:Name="PlaybackStartFlag" Content="{StaticResource Icon.Flag}" Style="{StaticResource MaterialIcon}" Width="16" Height="16"/>
</Canvas>
<Canvas x:Name="PlayheadOverlay" ClipToBounds="True">
