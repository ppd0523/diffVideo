<Grid.RenderTransform><TranslateTransform x:Name="TimelineTranslation"/></Grid.RenderTransform>
<Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
<Canvas x:Name="TimelineVideo1" Grid.Row="1" Background="{StaticResource CanvasBrush}" ClipToBounds="True" IsEnabled="{Binding IsEditingEnabled}">
                    <Border Height="{Binding ActualHeight, ElementName=TimelineVideo1, Converter={StaticResource ClipHeight}}" DataContext="{Binding Video1}" Style="{StaticResource VideoTimelineClip}" MouseLeftButtonDown="TimelineClip_MouseLeftButtonDown" MouseMove="TimelineClip_MouseMove" MouseLeftButtonUp="TimelineClip_MouseLeftButtonUp" LostMouseCapture="TimelineClip_LostMouseCapture">
                        <Border.Width><MultiBinding Converter="{StaticResource TimelineWidth}"><Binding Path="DurationSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineVideo1" /></MultiBinding></Border.Width>
                        <Canvas.Left><MultiBinding Converter="{StaticResource TimelinePosition}"><Binding Path="StartSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineVideo1" /></MultiBinding></Canvas.Left>
                        <StackPanel Margin="12,0"><TextBlock Tag="StartLabel" Text="{Binding StartSeconds, StringFormat=시작 {0:F3}초}" FontSize="11" /></StackPanel>
                    </Border>
                </Canvas>
<Canvas x:Name="TimelineVideo2" Grid.Row="2" Background="{StaticResource CanvasBrush}" ClipToBounds="True" IsEnabled="{Binding IsEditingEnabled}">
                    <Border Height="{Binding ActualHeight, ElementName=TimelineVideo2, Converter={StaticResource ClipHeight}}" DataContext="{Binding Video2}" Style="{StaticResource VideoTimelineClip}" MouseLeftButtonDown="TimelineClip_MouseLeftButtonDown" MouseMove="TimelineClip_MouseMove" MouseLeftButtonUp="TimelineClip_MouseLeftButtonUp" LostMouseCapture="TimelineClip_LostMouseCapture">
                        <Border.Width><MultiBinding Converter="{StaticResource TimelineWidth}"><Binding Path="DurationSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineVideo2" /></MultiBinding></Border.Width>
                        <Canvas.Left><MultiBinding Converter="{StaticResource TimelinePosition}"><Binding Path="StartSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineVideo2" /></MultiBinding></Canvas.Left>
                        <StackPanel Margin="12,0"><TextBlock Tag="StartLabel" Text="{Binding StartSeconds, StringFormat=시작 {0:F3}초}" FontSize="11" /></StackPanel>
                    </Border>
                </Canvas>
<Canvas x:Name="TimelineAudio" Grid.Row="3" Background="{StaticResource CanvasBrush}" ClipToBounds="True" IsEnabled="{Binding IsEditingEnabled}">
                    <Border Height="{Binding ActualHeight, ElementName=TimelineAudio, Converter={StaticResource ClipHeight}}" DataContext="{Binding Audio}" Style="{StaticResource TimelineClip}" MouseLeftButtonDown="TimelineClip_MouseLeftButtonDown" MouseMove="TimelineClip_MouseMove" MouseLeftButtonUp="TimelineClip_MouseLeftButtonUp" LostMouseCapture="TimelineClip_LostMouseCapture">
                        <Border.Width><MultiBinding Converter="{StaticResource TimelineWidth}"><Binding Path="DurationSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineAudio" /></MultiBinding></Border.Width>
                        <Canvas.Left><MultiBinding Converter="{StaticResource TimelinePosition}"><Binding Path="StartSeconds" /><Binding Path="DataContext.OutputDurationSeconds" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="ActualWidth" ElementName="TimelineAudio" /></MultiBinding></Canvas.Left>
                        <StackPanel Margin="12,0"><TextBlock Tag="StartLabel" Text="{Binding StartSeconds, StringFormat=시작 {0:F3}초}" FontSize="11" /></StackPanel>
                    </Border>
                </Canvas>
<Slider x:Name="PlayheadSlider" Grid.Row="4" Minimum="0" Maximum="{Binding OutputDurationSeconds}" Value="{Binding PlayheadSeconds, Mode=TwoWay}" IsMoveToPointEnabled="True" IsEnabled="{Binding CanNavigate}"
                        PreviewMouseDown="PlayheadSlider_PreviewMouseDown" PreviewMouseUp="PlayheadSlider_PreviewMouseUp" PreviewKeyDown="PlayheadSlider_PreviewKeyDown" PreviewKeyUp="PlayheadSlider_PreviewKeyUp" ValueChanged="PlayheadSlider_ValueChanged" Panel.ZIndex="50" AutomationProperties.Name="통합 영상 재생 위치">
<Slider.Template><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="2" VerticalAlignment="Center" Background="{StaticResource HairlineBrush}"/>
<Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
<Track.Thumb><Thumb Width="0" Height="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
</Track></Grid></ControlTemplate></Slider.Template></Slider>
</Grid>
<controls:AxisRuler x:Name="TimelineRuler" Height="22" VerticalAlignment="Top" IsHitTestVisible="False"/>
<Canvas x:Name="ExportRangeShadeOverlay" ClipToBounds="True" IsHitTestVisible="False">
    <Border x:Name="ExportBeforeShade" Background="#201C1917"/>
    <Border x:Name="ExportAfterShade" Background="#201C1917"/>
    <Border x:Name="ExportRangeBand" Height="22" Background="#30CA8A04"/>
    <Border x:Name="ExportStartLine" Width="2" Background="{StaticResource WarningBrush}"/>
    <Border x:Name="ExportEndLine" Width="2" Background="{StaticResource WarningBrush}"/>
</Canvas>
<Canvas x:Name="TimelineMarkerOverlay" ClipToBounds="True" IsHitTestVisible="False">
<ContentControl x:Name="PlaybackStartFlag" Content="{StaticResource Icon.Flag}" Style="{StaticResource MaterialIcon}" Width="16" Height="16"/>
</Canvas>
<Canvas x:Name="PlayheadOverlay" ClipToBounds="True">
<Thumb x:Name="PlayheadBar" Width="12" Cursor="SizeWE" IsEnabled="{Binding CanNavigate}" ToolTip="현재 재생 위치 · 드래그하여 이동" DragStarted="PlayheadBar_DragStarted" DragDelta="PlayheadBar_DragDelta" DragCompleted="PlayheadBar_DragCompleted">
<Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="2" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/><Border Width="6" Height="16" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid></ControlTemplate></Thumb.Template></Thumb>
</Canvas>
<Canvas x:Name="ExportRangeHandleOverlay" ClipToBounds="True">
    <Thumb x:Name="ExportStartHandle" Tag="[" Style="{StaticResource ExportBoundaryThumb}" IsEnabled="{Binding CanEditExportRange}" ToolTip="내보내기 시작 · 드래그로 이동" AutomationProperties.Name="내보내기 시작 경계" DragStarted="ExportRange_DragStarted" DragDelta="ExportRange_DragDelta" DragCompleted="ExportRange_DragCompleted"/>
    <Thumb x:Name="ExportEndHandle" Tag="]" Style="{StaticResource ExportBoundaryThumb}" IsEnabled="{Binding CanEditExportRange}" ToolTip="내보내기 종료 · 이 시각 직전까지 저장" AutomationProperties.Name="내보내기 종료 경계" DragStarted="ExportRange_DragStarted" DragDelta="ExportRange_DragDelta" DragCompleted="ExportRange_DragCompleted"/>
</Canvas></Grid>
<ScrollBar x:Name="TimelineScrollBar" Grid.Column="2" Grid.Row="5" Orientation="Horizontal" Scroll="TimelineScrollBar_Scroll" ValueChanged="TimelineScrollBar_ValueChanged" AutomationProperties.Name="타임라인 가로 스크롤"/>
</Grid></Grid></Border>
        <Border Grid.Row="3" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Grid.Column="1" Height="4" Minimum="0" Maximum="100" Value="{Binding ExportProgress, Mode=OneWay}" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
