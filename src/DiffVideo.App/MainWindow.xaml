<Window x:Class="DiffVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DiffVideo.App.Converters"
        xmlns:controls="clr-namespace:DiffVideo.App.Controls"
        Title="DiffVideo" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        Style="{StaticResource {x:Type Window}}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated">
    <Window.Resources>
        <conv:TimelinePositionConverter x:Key="TimelinePosition" />
        <conv:TimelineWidthConverter x:Key="TimelineWidth" />
        <conv:ClipHeightConverter x:Key="ClipHeight" />
        <Style x:Key="ExportBoundaryThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border Background="{StaticResource WarningBrush}" CornerRadius="0"><TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource CanvasBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MediaSelector" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{StaticResource MediumBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrackOverlay" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CanvasBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LilacBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimelineClip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Visibility" Value="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <Style x:Key="VideoTimelineClip" TargetType="Border" BasedOn="{StaticResource TimelineClip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource CanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainRootGrid" Margin="8">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition x:Name="TimelineRow" Height="264" MinHeight="264"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PreviewWorkspace" Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="216" /></Grid.ColumnDefinitions>
                <Border x:Name="PreviewDropHost" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="0" Padding="12"
                        AllowDrop="True" Drop="Preview_Drop" DragOver="Preview_DragOver" DragLeave="Preview_DragLeave" SizeChanged="PreviewDropHost_SizeChanged"
                        ToolTip="정지·일시정지: 왼쪽 드래그로 이동 · 변/모서리로 크기 조절 · 오른쪽 드래그로 ROI 지정 · Esc 취소 · Space 재생/일시정지">
                    <Grid>
                        <Viewbox x:Name="PreviewViewbox" Stretch="Uniform">
                            <Grid x:Name="PreviewLogicalCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="Black" Focusable="True"
                                  PreviewMouseRightButtonDown="PreviewRoi_RightButtonDown" PreviewMouseRightButtonUp="PreviewRoi_RightButtonUp"
                                  PreviewMouseMove="PreviewRoi_MouseMove" LostMouseCapture="PreviewRoi_LostMouseCapture">
                                <Image Source="{Binding PreviewImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas ClipToBounds="True" IsHitTestVisible="{Binding IsEditingEnabled}">
                                    <Border x:Name="Video1Overlay" DataContext="{Binding Video1}" Style="{StaticResource TrackOverlay}" Width="{Binding DestinationWidth}" Height="{Binding DestinationHeight}"
                                            Canvas.Left="{Binding DestinationX}" Canvas.Top="{Binding DestinationY}" Panel.ZIndex="{Binding ZIndex}" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}"
                                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp">
                                        <Border Background="#E61C1917" CornerRadius="0" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                            <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Foreground="{StaticResource CanvasBrush}" Width="28" Height="28" /><TextBlock Text="1" Foreground="{StaticResource CanvasBrush}" FontSize="22" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                        </Border>
                                    </Border>
                                    <Border x:Name="Video2Overlay" DataContext="{Binding Video2}" Style="{StaticResource TrackOverlay}" Width="{Binding DestinationWidth}" Height="{Binding DestinationHeight}"
                                            Canvas.Left="{Binding DestinationX}" Canvas.Top="{Binding DestinationY}" Panel.ZIndex="{Binding ZIndex}" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}"
                                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp">
                                        <Border Background="#E61C1917" CornerRadius="0" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                            <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Foreground="{StaticResource CanvasBrush}" Width="28" Height="28" /><TextBlock Text="2" Foreground="{StaticResource CanvasBrush}" FontSize="22" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                        </Border>
                                    </Border>
                                </Canvas>
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Rectangle x:Name="PreviewRoiSelection" Visibility="Collapsed" Stroke="{StaticResource CanvasBrush}" Fill="#4078716C" StrokeDashArray="4,2" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <controls:CoordinateTip x:Name="PreviewCoordinateTip" Panel.ZIndex="120"/>
                        <Border Background="{StaticResource SurfaceBrush}">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasComposition}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Button Click="OpenFiles_Click" IsEnabled="{Binding IsEditingEnabled}"
                                    Width="240" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="영상 프리뷰 · MP4 영상 또는 MP3 음원을 끌어 놓거나 클릭하여 열기"
                                    AutomationProperties.Name="영상 또는 음원 열기"
                                    AutomationProperties.HelpText="영상 프리뷰 구역입니다. MP4 영상 또는 MP3 음원을 끌어 놓을 수 있습니다.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Rectangle Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeDashArray="4,4" Margin="1" />
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <ContentControl Content="{StaticResource Icon.VideoLibrary}" Style="{StaticResource MaterialIcon}" Foreground="{TemplateBinding Foreground}" Width="64" Height="64" />
                                                            <Path Data="M 12,0 L 12,20 M 4,12 L 12,20 L 20,12 M 0,24 L 0,28 L 24,28 L 24,24"
                                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Width="28" Height="32" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <Border x:Name="PreviewLoadingOverlay" Background="#CC1C1917" CornerRadius="0" IsHitTestVisible="False" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="100">
                            <Border Background="{StaticResource CanvasBrush}" CornerRadius="0" Padding="24,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Width="176">
                                    <TextBlock Text="재생 동기화 중…" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <ProgressBar IsIndeterminate="True" Height="4" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border x:Name="PreviewDropHint" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6FAFAF9" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="3" CornerRadius="0" Panel.ZIndex="110">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl Content="{StaticResource Icon.FolderOpen}" Style="{StaticResource MaterialIcon}" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="놓아서 MP4 / MP3 추가" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            <Border x:Name="InspectorPanel" Grid.Column="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="0" Padding="12">
                <Grid>
                    <TabControl x:Name="SettingsTabs" SelectedIndex="1">
                        <TabItem x:Name="CanvasSettingsTab" Header="캔버스">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsEnabled="{Binding IsEditingEnabled}">
                                    <TextBlock Text="캔버스 크기" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <TextBox Text="{Binding CanvasWidth, UpdateSourceTrigger=LostFocus}" ToolTip="캔버스 너비 (px)" AutomationProperties.Name="캔버스 너비" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding CanvasHeight, UpdateSourceTrigger=LostFocus}" ToolTip="캔버스 높이 (px)" AutomationProperties.Name="캔버스 높이" Margin="4,0,0,0" />
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <Button Content="720p" Click="Canvas720_Click" Style="{StaticResource CompactButton}" Padding="8,6" Margin="0,0,4,0" />
                                        <Button Content="1080p" Click="Canvas1080_Click" Style="{StaticResource CompactButton}" Padding="8,6" Margin="2,0" />
                                        <Button Content="4K" Click="Canvas4K_Click" Style="{StaticResource CompactButton}" Padding="8,6" Margin="4,0,0,0" />
                                    </UniformGrid>
                                    <Border Height="1" Background="{StaticResource SoftHairlineBrush}" Margin="0,24,0,0" />
                                    <TextBlock Text="프레임 레이트" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="fps" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBox x:Name="FpsInput" Text="{Binding OutputFps, UpdateSourceTrigger=LostFocus}" ToolTip="출력 프레임 레이트 (1~60 fps)" AutomationProperties.Name="출력 프레임 레이트" />
                                    </DockPanel>
                                    <UniformGrid Columns="5" Margin="0,8,0,0">
                                        <Button x:Name="Fps24Button" Content="24" Tag="24" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="0,0,3,0" />
                                        <Button Content="25" Tag="25" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="1.5,0" />
                                        <Button Content="30" Tag="30" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="1.5,0" />
                                        <Button Content="50" Tag="50" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="1.5,0" />
                                        <Button Content="60" Tag="60" Click="FpsPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="3,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock Text="품질" Style="{StaticResource FieldLabel}" />
                                    <UniformGrid Columns="3">
                                        <Button x:Name="QualityHighButton" Content="High" Tag="High" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="0,0,4,0" />
                                        <Button Content="Mid" Tag="Balanced" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="2,0" />
                                        <Button Content="Low" Tag="Small" Click="QualityPreset_Click" Style="{StaticResource CompactButton}" Padding="4.8,3.6" Margin="4,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock Text="전체 길이" Style="{StaticResource FieldLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="초" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox Text="{Binding OutputDurationSeconds, StringFormat=F1, UpdateSourceTrigger=LostFocus}" ToolTip="출력 종료 시각 (초)" AutomationProperties.Name="출력 종료 시각" /></DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="VideoSettingsTab" Header="영상">
                            <Grid IsEnabled="{Binding IsEditingEnabled}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto"/><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border DataContext="{Binding Video1}" Margin="0,0,8,0"><Button Style="{StaticResource MediaSelector}" Padding="9.6,4.8" MinHeight="29.6" Click="MediaVideo_Click" ToolTip="영상 1 선택" AutomationProperties.Name="영상 1 선택"><StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" /><TextBlock Text="1" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button></Border>
                                    <Border DataContext="{Binding Video2}"><Button Style="{StaticResource MediaSelector}" Padding="9.6,4.8" MinHeight="29.6" Click="MediaVideo_Click" ToolTip="영상 2 선택" AutomationProperties.Name="영상 2 선택"><StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Icon.Movie}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" /><TextBlock Text="2" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button></Border>
                                    <Button x:Name="ResetRoiButton" Content="{StaticResource Icon.CropFree}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="선택 영상의 ROI를 원본 전체로 복원" Click="ResetRoi_Click" IsEnabled="{Binding SelectedVideo.HasMedia}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock x:Name="SelectedVideoFileName" Text="{Binding SelectedVideo.DisplayName}" Style="{StaticResource InspectorHeading}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedVideo.DisplayName}" Margin="0,0,0,12" />
                                    <TextBlock Text="레이어" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal"><Button x:Name="SendBackwardButton" Content="{StaticResource Icon.FlipToBack}" Click="SendBackward_Click" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="선택한 영상을 뒤로 보내기" Margin="0,0,8,0" /><Button x:Name="BringForwardButton" Content="{StaticResource Icon.FlipToFront}" Click="BringForward_Click" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="선택한 영상을 앞으로 가져오기" /></StackPanel>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel DataContext="{Binding SelectedVideo}">
                                        <TextBlock Text="배치" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                                        <DockPanel><TextBlock Text="시작" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBox Padding="7.2,4.8" MinHeight="33.6" Text="{Binding StartSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" ToolTip="영상 시작 시각 (초)" AutomationProperties.Name="영상 시작 시각" /></DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><ContentControl Content="{StaticResource Icon.OpenWith}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" ToolTip="캔버스 위치" /><TextBlock Text="X / Y" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" /></StackPanel>
                                        <UniformGrid Columns="2"><TextBox Padding="7.2,4.8" MinHeight="33.6" Text="{Binding DestinationX}" Margin="0,0,4,0" ToolTip="X 위치" AutomationProperties.Name="X 위치" /><TextBox Padding="7.2,4.8" MinHeight="33.6" Text="{Binding DestinationY}" Margin="4,0,0,0" ToolTip="Y 위치" AutomationProperties.Name="Y 위치" /></UniformGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><ContentControl Content="{StaticResource Icon.AspectRatio}" Style="{StaticResource MaterialIcon}" Width="20" Height="20" ToolTip="표시 크기" /><TextBlock Text="너비 / 높이" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" /></StackPanel>
                                        <UniformGrid Columns="2"><TextBox Padding="7.2,4.8" MinHeight="33.6" Text="{Binding DestinationWidth}" Margin="0,0,4,0" AutomationProperties.Name="표시 너비" /><TextBox Padding="7.2,4.8" MinHeight="33.6" Text="{Binding DestinationHeight}" Margin="4,0,0,0" AutomationProperties.Name="표시 높이" /></UniformGrid>
                                        <CheckBox x:Name="AspectLockCheckBox" Style="{StaticResource AspectLockIconCheckBox}" IsChecked="{Binding AspectRatioLocked}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                        <ComboBox Padding="7.2,4.8" MinHeight="33.6" x:Name="FitCombo" ItemsSource="{Binding DataContext.FitChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FitMode}" AutomationProperties.Name="영상 맞춤 방식" />
                                        <Border Height="1" Background="{StaticResource SoftHairlineBrush}" Margin="0,24,0,0" />
                                        <TextBlock Text="자르기" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="EditRoiButton" Content="{StaticResource Icon.Crop}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="별도 창에서 ROI 편집 · 프리뷰에서는 오른쪽 버튼 드래그" Click="EditRoi_Click" Margin="0,0,8,0" />
                                            <TextBlock Text="ROI 편집" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="프리뷰에서 우클릭 드래그" FontSize="11" Margin="0,0,0,8" />
                                        <TextBlock Text="X / Y" FontSize="11" Margin="0,0,0,4" />
                                        <UniformGrid Columns="2"><TextBox Padding="7.2,4.8" MinHeight="33.6" x:Name="RoiXInput" Text="{Binding RoiX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" AutomationProperties.Name="ROI X" /><TextBox Padding="7.2,4.8" MinHeight="33.6" x:Name="RoiYInput" Text="{Binding RoiY, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" AutomationProperties.Name="ROI Y" /></UniformGrid>
                                        <TextBlock Text="너비 / 높이" FontSize="11" Margin="0,8,0,4" />
                                        <UniformGrid Columns="2"><TextBox Padding="7.2,4.8" MinHeight="33.6" x:Name="RoiWidthInput" Text="{Binding RoiWidth, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" AutomationProperties.Name="ROI 너비" /><TextBox Padding="7.2,4.8" MinHeight="33.6" x:Name="RoiHeightInput" Text="{Binding RoiHeight, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" AutomationProperties.Name="ROI 높이" /></UniformGrid>
                                        <Border Height="1" Background="{StaticResource SoftHairlineBrush}" Margin="0,24,0,0" />
                                        <TextBlock Text="오디오" Style="{StaticResource FieldLabel}" />
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" VerticalAlignment="Center" Margin="8,0,0,0" /><Slider Minimum="0" Maximum="200" Value="{Binding VolumePercent}" AutomationProperties.Name="영상 오디오 볼륨" /></DockPanel>
                                        <CheckBox x:Name="InspectorAudioCheckBox" Style="{StaticResource AudioIconCheckBox}" IsChecked="{Binding IncludeAudio}" IsEnabled="{Binding HasAudio}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <Thumb x:Name="TimelineHeightSplitter" Grid.Row="1" Height="8" Cursor="SizeNS" DragDelta="TimelineHeight_DragDelta" ToolTip="타임라인 높이 조절">
<Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="64" Height="2" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
<Border Grid.Row="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="0" Padding="8">
<Grid x:Name="IntegratedTimeline" ClipToBounds="True" SizeChanged="Timeline_SizeChanged">
<Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TransportBar" Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaybackTimeDisplay" Text="{Binding PlayheadText}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="·" Margin="12,0" />
                        <TextBlock Text="{Binding PlaybackStartText}" FontSize="13" />
                        <ContentControl ToolTip="{Binding PlaybackStateText}" Width="18" Height="18" Margin="12,0,0,0"><ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource MaterialIcon}"><Setter Property="Content" Value="{StaticResource Icon.Stop}" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Content" Value="{StaticResource Icon.PlayArrow}" /></DataTrigger><DataTrigger Binding="{Binding CurrentPlaybackState}" Value="Paused"><Setter Property="Content" Value="{StaticResource Icon.Pause}" /></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                        <Button x:Name="PlayButton" Content="{StaticResource Icon.PlayArrow}" Click="Play_Click" IsEnabled="{Binding CanPlay}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="재생 (Space) · 현재 재생 위치에서 시작" Margin="0,0,4,0" />
                        <Button x:Name="PauseButton" Content="{StaticResource Icon.Pause}" Click="Pause_Click" IsEnabled="{Binding CanPause}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="일시정지 (Space) · 현재 위치 유지" Margin="0,0,4,0" />
                        <Button x:Name="StopButton" Content="{StaticResource Icon.Stop}" Click="Stop_Click" IsEnabled="{Binding CanStop}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="정지 · 지정한 시작점으로 이동" Margin="0,0,12,0" />
                        <Button x:Name="PreviousFrameButton" Content="{StaticResource Icon.SkipPrevious}" Click="PreviousFrame_Click" IsEnabled="{Binding CanNavigate}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="이전 1프레임" Margin="0,0,4,0" />
                        <Button x:Name="NextFrameButton" Content="{StaticResource Icon.SkipNext}" Click="NextFrame_Click" IsEnabled="{Binding CanNavigate}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="다음 1프레임" Margin="0,0,12,0" />
                        <Button x:Name="SetStartButton" Content="{StaticResource Icon.Flag}" Click="SetPlaybackStart_Click" IsEnabled="{Binding CanSetPlaybackStart}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="현재 위치를 재생 시작점으로 지정" />
                        <Button x:Name="ZoomOutButton" Content="{StaticResource Icon.Remove}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="타임라인 축소" Click="ZoomOut_Click" Margin="12,0,0,0"/>
                        <Button x:Name="ZoomInButton" Content="{StaticResource Icon.Add}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="타임라인 확대" Click="ZoomIn_Click"/>
                        <Button x:Name="FitTimelineButton" Content="{StaticResource Icon.AspectRatio}" Style="{StaticResource MaterialIconButton}" Width="38.4" Height="38.4" MinHeight="38.4" ToolTip="타임라인 전체 보기" Click="FitTimeline_Click"/>
                    </StackPanel>
                </Grid>
<Grid x:Name="ExportRangeToolbar" Grid.Row="1" Margin="0,2,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding CanEditExportRange}">
        <TextBlock Text="내보내기 구간" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Text="시작" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="ExportStartInput" Width="80" VerticalAlignment="Center" Text="{Binding ExportStartSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" ToolTip="내보내기 시작 (초)" AutomationProperties.Name="내보내기 시작 시각"/>
        <Button x:Name="SetExportStartButton" Content="지금" Click="SetExportStart_Click" ToolTip="현재 재생 위치를 내보내기 시작으로 지정" Style="{StaticResource CompactButton}" Height="33.6" Padding="4.8,2.4" Margin="4,0,8,0"/>
        <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="끝" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="ExportEndInput" Width="80" VerticalAlignment="Center" Text="{Binding ExportEndSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" ToolTip="내보내기 종료 경계 (초) · 이 시각 직전까지 저장" AutomationProperties.Name="내보내기 종료 시각"/>
        <Button x:Name="SetExportEndButton" Content="지금" Click="SetExportEnd_Click" ToolTip="현재 재생 위치를 종료 경계로 지정 · 이 시각 직전까지 저장" Style="{StaticResource CompactButton}" Height="33.6" Padding="4.8,2.4" Margin="4,0,0,0"/>
    </StackPanel>
    <StackPanel x:Name="ExportActions" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="SetOverlapRangeButton" Content="교차" Click="SetOverlapRange_Click" IsEnabled="{Binding CanEditExportRange}" ToolTip="두 영상이 동시에 재생되는 구간으로 설정" Style="{StaticResource CompactButton}" Height="33.6" Padding="7.2,2.4" Margin="0,0,4,0"/>
        <Button x:Name="SetVideoRangeButton" Content="전체" Click="SetVideoRange_Click" IsEnabled="{Binding CanEditExportRange}" ToolTip="두 영상의 최초 시작부터 최종 종료까지 설정" Style="{StaticResource CompactButton}" Height="33.6" Padding="7.2,2.4" Margin="0,0,12,0"/>
        <Grid>
            <Button x:Name="ExportButton" Content="{StaticResource Icon.FileDownload}" ToolTip="합성 영상을 MP4로 저장" Click="Export_Click" IsEnabled="{Binding CanStartExport}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryMaterialIconButton}"><Setter Property="Width" Value="33.6"/><Setter Property="Height" Value="33.6"/><Setter Property="MinHeight" Value="33.6"/><Style.Triggers><DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <Button x:Name="CancelExportButton" Content="{StaticResource Icon.Cancel}" ToolTip="진행 중인 내보내기 취소" Click="CancelExport_Click">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MaterialIconButton}"><Setter Property="Width" Value="33.6"/><Setter Property="Height" Value="33.6"/><Setter Property="MinHeight" Value="33.6"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
        </Grid>
    </StackPanel>
</Grid>
<Grid x:Name="TimelineBody" Grid.Row="2">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="TimelineLabelColumn" Width="204" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="32"/><RowDefinition Height="16"/></Grid.RowDefinitions>
<ContentControl Content="{StaticResource Icon.ViewTimeline}" Style="{StaticResource MaterialIcon}" ToolTip="통합 타임라인" HorizontalAlignment="Left" Width="18" Height="18"/>
<DockPanel Grid.Row="1" DataContext="{Binding Video1}" Margin="0,0,6,0" IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
<CheckBox x:Name="Video1AudioCheckBox" DockPanel.Dock="Right" Style="{StaticResource TimelineAudioIconCheckBox}" IsChecked="{Binding IncludeAudio}" IsEnabled="{Binding HasAudio}"/>

