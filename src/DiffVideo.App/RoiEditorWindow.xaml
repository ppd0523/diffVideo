<Window x:Class="DiffVideo.App.RoiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiffVideo.App.Controls"
        Title="ROI 편집" Width="1000" Height="720" MinWidth="640" MinHeight="480"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="GridToggleButton" DockPanel.Dock="Right" Content="{StaticResource Icon.GridOn}" Style="{StaticResource MaterialIconButton}" Click="GridToggle_Click" ToolTip="그리드 숨기기 (100px)" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="필요한 장면만 남기세요." FontSize="26" FontWeight="Light"/>
                <TextBlock Text="내부: 이동 · 변/모서리: 크기 조절 · 외부: 새 영역 · Esc: 드래그 취소" FontSize="12" TextWrapping="Wrap" Margin="0,8,12,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
            <Grid x:Name="RulerImageSurface">
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="px" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <controls:AxisRuler x:Name="SourceXRuler" Grid.Column="1" SourcePixels="True"/>
                <controls:AxisRuler x:Name="SourceYRuler" Grid.Row="1" SourcePixels="True" Vertical="True"/>
                <Grid x:Name="ImageHost" Grid.Row="1" Grid.Column="1" Background="Black" ClipToBounds="True" Focusable="True"
                      MouseLeftButtonDown="ImageHost_MouseLeftButtonDown" MouseMove="ImageHost_MouseMove"
                      MouseLeave="ImageHost_MouseLeave" MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                      LostMouseCapture="ImageHost_LostMouseCapture" SizeChanged="ImageHost_SizeChanged">
                    <Image x:Name="SourceImage" Stretch="Uniform"/>
                    <controls:SourcePixelGrid x:Name="PixelGrid"/>
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="RoiRectangle" Stroke="{StaticResource LilacBrush}" StrokeThickness="2" Fill="#16C5B0F4"/>
                    </Canvas>
                    <Canvas x:Name="HandleCanvas" IsHitTestVisible="False"/>
                </Grid>
                <Canvas x:Name="CrosshairOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                    <Line x:Name="VerticalGuide" Stroke="#C5B0F4" StrokeThickness="1"/>
                    <Line x:Name="HorizontalGuide" Stroke="#C5B0F4" StrokeThickness="1"/>
                </Canvas>
                <controls:CoordinateTip x:Name="SourceCoordinateTip" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <UniformGrid Columns="4">
<DockPanel Margin="0,0,8,0"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="XInput" Tag="X" Text="0" ToolTip="원본 ROI X 위치 (px)" AutomationProperties.Name="ROI X 위치" LostKeyboardFocus="Number_LostKeyboardFocus" PreviewKeyDown="Number_PreviewKeyDown"/></DockPanel>
<DockPanel Margin="0,0,8,0"><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="YInput" Tag="Y" Text="0" ToolTip="원본 ROI Y 위치 (px)" AutomationProperties.Name="ROI Y 위치" LostKeyboardFocus="Number_LostKeyboardFocus" PreviewKeyDown="Number_PreviewKeyDown"/></DockPanel>
<DockPanel Margin="0,0,8,0"><TextBlock Text="W" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="WidthInput" Tag="Width" Text="0" ToolTip="원본 ROI 너비 (px)" AutomationProperties.Name="ROI 너비" LostKeyboardFocus="Number_LostKeyboardFocus" PreviewKeyDown="Number_PreviewKeyDown"/></DockPanel>
<DockPanel Margin="0,0,0,0"><TextBlock Text="H" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="HeightInput" Tag="Height" Text="0" ToolTip="원본 ROI 높이 (px)" AutomationProperties.Name="ROI 높이" LostKeyboardFocus="Number_LostKeyboardFocus" PreviewKeyDown="Number_PreviewKeyDown"/></DockPanel>
            </UniformGrid>
            <TextBlock x:Name="RoiText" Grid.Row="1" FontSize="11" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/>
            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button x:Name="FullFrameButton" Content="{StaticResource Icon.CropFree}" Style="{StaticResource MaterialIconButton}" ToolTip="자르기 영역을 전체 프레임으로 초기화" Click="FullFrame_Click" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CancelRoiButton" Content="{StaticResource Icon.Close}" Style="{StaticResource MaterialIconButton}" ToolTip="ROI 편집 취소" IsCancel="True" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyRoiButton" Content="{StaticResource Icon.Check}" ToolTip="자르기 영역 적용" IsDefault="True" Click="Apply_Click" Style="{StaticResource PrimaryMaterialIconButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
